<Ui xmlns="http://www.blizzard.com/wow/ui/">
  <Frame
    name="AuctionatorConfigurationRadioButtonGroup"
    virtual="true">

    <Scripts>
      <OnLoad>
        Mixin(self, AuctionatorConfigRadioButtonGroupMixin)

        self.GroupHeading = select(1, self:GetChildren())

        if self.InitializeRadioButtonGroup then
          self:InitializeRadioButtonGroup()
        end
      </OnLoad>
    </Scripts>

    <Anchors>
      <Anchor point="LEFT" relativeTo="$parent" relativePoint="LEFT"/>
      <Anchor point="RIGHT" relativeTo="$parent" relativePoint="RIGHT"/>
    </Anchors>

    <Frames>
      <Frame
        name="$parentGroupHeading"
        inherits="AuctionatorConfigurationSubHeadingFrame">

        <Anchors>
          <Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="TOPLEFT"/>
        </Anchors>
      </Frame>
    </Frames>
  </Frame>
</Ui>