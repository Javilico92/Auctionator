<Ui xmlns="http://www.blizzard.com/wow/ui/">
  <Frame
    name="AuctionatorConfigLIFOFrame"
    parent="InterfaceOptionsFrame"
    hidden="true">

    <Scripts>
      <OnLoad>
        AuctionatorXMLCompat.InitializeDeferred(
          self,
          "AuctionatorConfigLIFOFrame"
        )
      </OnLoad>

      <OnShow>
        AuctionatorXMLCompat.Call(self, "OnShow")
      </OnShow>

      <OnHide>
        AuctionatorXMLCompat.Call(self, "Save")
      </OnHide>
    </Scripts>

    <Frames>
      <!-- Título -->
      <Frame
        name="$parentTitleArea"
        inherits="AuctionatorConfigurationTitleFrame">

        <!-- Conservados como referencia; 3.3.5 los ignora -->
        <KeyValues>
          <KeyValue
            key="titleText"
            value="AUCTIONATOR_L_CONFIG_SELLING_LIFO_HEADER"
            type="global"/>

          <KeyValue
            key="subTitleText"
            value="AUCTIONATOR_L_CONFIG_SELLING_LIFO_TEXT"
            type="global"/>
        </KeyValues>
      </Frame>

      <!-- Duración de las subastas -->
      <Frame
        name="$parentCommodityDurationGroup"
        inherits="AuctionatorConfigurationRadioButtonGroup">

        <KeyValues>
          <KeyValue
            key="groupHeadingText"
            value="AUCTIONATOR_L_DEFAULT_AUCTION_DURATION"
            type="global"/>
        </KeyValues>

        <Anchors>
          <Anchor
            point="TOPLEFT"
            relativeTo="$parentTitleArea"
            relativePoint="BOTTOMLEFT">

            <Offset>
              <AbsDimension x="0" y="-10"/>
            </Offset>
          </Anchor>
        </Anchors>

        <Frames>
          <Frame
            name="$parentDuration12"
            inherits="AuctionatorConfigurationRadioButton">

            <KeyValues>
              <KeyValue
                key="labelText"
                value="AUCTIONATOR_L_AUCTION_DURATION_12"
                type="global"/>

              <KeyValue
                key="value"
                value="12"
                type="number"/>
            </KeyValues>
          </Frame>

          <Frame
            name="$parentDuration24"
            inherits="AuctionatorConfigurationRadioButton">

            <KeyValues>
              <KeyValue
                key="labelText"
                value="AUCTIONATOR_L_AUCTION_DURATION_24"
                type="global"/>

              <KeyValue
                key="value"
                value="24"
                type="number"/>
            </KeyValues>
          </Frame>

          <Frame
            name="$parentDuration48"
            inherits="AuctionatorConfigurationRadioButton">

            <KeyValues>
              <KeyValue
                key="labelText"
                value="AUCTIONATOR_L_AUCTION_DURATION_48"
                type="global"/>

              <KeyValue
                key="value"
                value="48"
                type="number"/>
            </KeyValues>
          </Frame>
        </Frames>
      </Frame>

      <!-- Preferencia de venta -->
      <Frame
        name="$parentCommoditySalesPreference"
        inherits="AuctionatorConfigurationRadioButtonGroup">

        <KeyValues>
          <KeyValue
            key="groupHeadingText"
            value="AUCTIONATOR_L_SALES_PREFERENCE"
            type="global"/>
        </KeyValues>

        <Anchors>
          <Anchor
            point="TOPLEFT"
            relativeTo="$parentCommodityDurationGroup"
            relativePoint="BOTTOMLEFT">

            <Offset>
              <AbsDimension x="0" y="-10"/>
            </Offset>
          </Anchor>
        </Anchors>

        <Frames>
          <Frame
            name="$parentPreferencePercentage"
            inherits="AuctionatorConfigurationRadioButton">

            <KeyValues>
              <KeyValue
                key="labelText"
                value="AUCTIONATOR_L_PERCENTAGE"
                type="global"/>

              <KeyValue
                key="value"
                value="percentage"
                type="string"/>
            </KeyValues>
          </Frame>

          <Frame
            name="$parentPreferenceStatic"
            inherits="AuctionatorConfigurationRadioButton">

            <KeyValues>
              <KeyValue
                key="labelText"
                value="AUCTIONATOR_L_SET_VALUE"
                type="global"/>

              <KeyValue
                key="value"
                value="static"
                type="string"/>
            </KeyValues>
          </Frame>
        </Frames>
      </Frame>

      <!-- Porcentaje de descuento -->
      <Frame
        name="$parentCommodityUndercutPercentage"
        inherits="AuctionatorConfigurationNumericInput"
        hidden="true">

        <KeyValues>
          <KeyValue
            key="labelText"
            value="AUCTIONATOR_L_PERCENTAGE_SUFFIX"
            type="global"/>

          <KeyValue
            key="tooltipTitleText"
            value="AUCTIONATOR_L_PERCENTAGE_TOOLTIP_HEADER"
            type="global"/>

          <KeyValue
            key="tooltipText"
            value="AUCTIONATOR_L_PERCENTAGE_TOOLTIP_TEXT"
            type="global"/>
        </KeyValues>

        <Anchors>
          <Anchor
            point="TOPLEFT"
            relativeTo="$parentCommoditySalesPreference"
            relativePoint="BOTTOMLEFT">

            <Offset>
              <AbsDimension x="0" y="-10"/>
            </Offset>
          </Anchor>
        </Anchors>
      </Frame>

      <!-- Valor fijo de descuento -->
      <Frame
        name="$parentCommodityUndercutValue"
        inherits="AuctionatorConfigurationMoneyInput"
        hidden="true">

        <KeyValues>
          <KeyValue
            key="labelText"
            value="AUCTIONATOR_L_SET_VALUE_SUFFIX"
            type="global"/>

          <KeyValue
            key="tooltipTitleText"
            value="AUCTIONATOR_L_UNDERCUT_TOOLTIP_HEADER"
            type="global"/>

          <KeyValue
            key="tooltipText"
            value="AUCTIONATOR_L_UNDERCUT_TOOLTIP_TEXT"
            type="global"/>
        </KeyValues>

        <Anchors>
          <Anchor
            point="TOPLEFT"
            relativeTo="$parentCommoditySalesPreference"
            relativePoint="BOTTOMLEFT">

            <Offset>
              <AbsDimension x="0" y="-10"/>
            </Offset>
          </Anchor>
        </Anchors>
      </Frame>
    </Frames>
  </Frame>
</Ui>