<Ui xmlns="http://www.blizzard.com/wow/ui/">
  <Frame
    name="AuctionatorConfigBasicOptionsFrame"
    parent="InterfaceOptionsFrame">

    <Scripts>
      <OnLoad>
        AuctionatorXMLCompat.InitializeDeferred(
          self,
          "AuctionatorConfigBasicOptionsFrame"
        )
      </OnLoad>

      <OnShow>
        AuctionatorXMLCompat.Call(self, "OnShow")
      </OnShow>

      <OnHide>
        AuctionatorXMLCompat.Call(self, "Save")
      </OnHide>
    </Scripts>

    <Frames>
      <Frame
        name="$parentTitleArea"
        inherits="AuctionatorConfigurationTitleFrame"/>

      <Frame
        name="$parentShoppingListHeading"
        inherits="AuctionatorConfigurationHeadingFrame">

        <Anchors>
          <Anchor
            point="TOPLEFT"
            relativeTo="$parentTitleArea"
            relativePoint="BOTTOMLEFT"/>
        </Anchors>
      </Frame>

      <Frame
        name="$parentAutoListSearch"
        inherits="AuctionatorConfigurationCheckbox">

        <Anchors>
          <Anchor
            point="TOPLEFT"
            relativeTo="$parentShoppingListHeading"
            relativePoint="BOTTOMLEFT"/>
        </Anchors>
      </Frame>

      <Frame
        name="$parentAuctionChatLog"
        inherits="AuctionatorConfigurationCheckbox">

        <Anchors>
          <Anchor
            point="TOPLEFT"
            relativeTo="$parentAutoListSearch"
            relativePoint="BOTTOMLEFT"/>
        </Anchors>
      </Frame>

      <Frame
        name="$parentScanningHeading"
        inherits="AuctionatorConfigurationHeadingFrame">

        <Anchors>
          <Anchor
            point="TOPLEFT"
            relativeTo="$parentAuctionChatLog"
            relativePoint="BOTTOMLEFT"/>
        </Anchors>
      </Frame>

      <Frame
        name="$parentAutoscan"
        inherits="AuctionatorConfigurationCheckbox">

        <Anchors>
          <Anchor
            point="TOPLEFT"
            relativeTo="$parentScanningHeading"
            relativePoint="BOTTOMLEFT"/>
        </Anchors>
      </Frame>

      <Frame
        name="$parentAlternateScan"
        inherits="AuctionatorConfigurationCheckbox">

        <Anchors>
          <Anchor
            point="TOPLEFT"
            relativeTo="$parentAutoscan"
            relativePoint="BOTTOMLEFT"/>
        </Anchors>
      </Frame>

      <Frame
        name="$parentCancellingHeading"
        inherits="AuctionatorConfigurationHeadingFrame">

        <Anchors>
          <Anchor
            point="TOPLEFT"
            relativeTo="$parentAlternateScan"
            relativePoint="BOTTOMLEFT"/>
        </Anchors>
      </Frame>

      <Frame
        name="$parentUndercutScanPetsGear"
        inherits="AuctionatorConfigurationCheckbox">

        <Anchors>
          <Anchor
            point="TOPLEFT"
            relativeTo="$parentCancellingHeading"
            relativePoint="BOTTOMLEFT"/>
        </Anchors>
      </Frame>
    </Frames>
  </Frame>
</Ui>