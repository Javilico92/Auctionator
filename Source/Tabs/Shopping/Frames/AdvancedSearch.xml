<Ui xmlns="http://www.blizzard.com/wow/ui/">
  <Frame
    name="AuctionatorShoppingAdvancedSearchDialog"
    parent="UIParent"
    hidden="true"
    enableMouse="true"
    movable="true"
    frameStrata="FULLSCREEN_DIALOG">

    <Size>
      <AbsDimension x="500" y="330"/>
    </Size>

    <Anchors>
      <Anchor point="CENTER" relativeTo="UIParent" relativePoint="CENTER">
        <Offset>
          <AbsDimension x="0" y="40"/>
        </Offset>
      </Anchor>
    </Anchors>

    <Scripts>
      <OnLoad>
        Auctionator.Shopping.AdvancedSearch.OnLoad(self)
      </OnLoad>
      <OnMouseDown>
        if arg1 == "LeftButton" then self:StartMoving() end
      </OnMouseDown>
      <OnMouseUp>
        self:StopMovingOrSizing()
      </OnMouseUp>
    </Scripts>
  </Frame>
</Ui>
